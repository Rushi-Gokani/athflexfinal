{% if product.metafields.custom.upsells != blank %}

  {% assign main_price = product.price | divided_by: 100 %}
  {% assign addon_total = 0 %}
  {% assign isMore = true %}

  <h4 class="secondary-product-title" style="margin:20px 0px;">Complete the look</h4>
  <div class="upsells-short">

    {% assign products_upsell = product.metafields.custom.upsells %}
      {% for product in products_upsell.value %}
      <div class="upsell-short">
        {% render 'product-grid-layout',
                    product_card_product: product,
                    portrait_aspect_ratio: '125',
                    serial: forloop.index,
                    sectionId: sectionId,
                    media_size: image_ratio,
                    hasCountdown: hasCountdown,
                    loading: true
                %}
      </div>

      <div hidden>
        {% for variants in product.variants %}


          <p data-available="{{variants.available}}" data-id="{{variants.id}}">
            {{ variants.option1 }}</p>

          {% if forloop.index == 1 %}
            {% assign addon = variants.price | divided_by: 100 %}

            {% assign addon_total = addon_total | plus: addon %}
          {% endif %}

        {% endfor %}
      </div>

      {% comment %} {{ forloop.index }}{{ product.metafields.custom.upsells | json }} {% endcomment %}

      <svg
        width="24"
        height="24"
        fill="none"
        class="plusupsell"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"><path d="M11.883 3.007 12 3a1 1 0 0 1 .993.883L13 4v7h7a1 1 0 0 1 .993.883L21 12a1 1 0 0 1-.883.993L20 13h-7v7a1 1 0 0 1-.883.993L12 21a1 1 0 0 1-.993-.883L11 20v-7H4a1 1 0 0 1-.993-.883L3 12a1 1 0 0 1 .883-.993L4 11h7V4a1 1 0 0 1 .883-.993L12 3l-.117.007Z" fill="#222F3D" /></svg>


    {% endfor %}

    {% comment %}  <div>
    <h4>Total Price : Rs.{{ addon_total | plus: main_price }}</h4>
    <button>See All Buying Options</button>
    </div> {% endcomment %}

  </div>

{% endif %}