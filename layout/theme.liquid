  // Function to remove the native account icon for desktop and mobile
  function removeNativeAccountIcon() {
    var nativeAccountIconDesktop = document.querySelector('.header--account.header--icon-border');
    if (nativeAccountIconDesktop) {
      nativeAccountIconDesktop.parentElement.removeChild(nativeAccountIconDesktop);
    }

    var nativeAccountIconMobile = document.querySelector('.header-mobile__item.header-mobile__item--customer');
    if (nativeAccountIconMobile) {
      nativeAccountIconMobile.parentElement.removeChild(nativeAccountIconMobile);
    }
  }

  // Function to add the custom account icon at the right position for desktop
  function addAccountIconDesktop() {
    var accountContainerDesktop = document.querySelector('.header--wishlist.header--icon-border.d-flex.flex-align-center.h-100.d-flex.p-relative');

    if (accountContainerDesktop) {
      var accountLinkDesktop = document.createElement('a');
      accountLinkDesktop.classList.add('custom-account-icon');
      accountLinkDesktop.title = 'Account';

      if (isCustomerLoggedIn()) {
        // User is logged in: Link to /account
        accountLinkDesktop.href = '/account';
      } else {
        // User is not logged in: Trigger login function on click
        accountLinkDesktop.href = '#';
        accountLinkDesktop.onclick = function(event) {
          event.preventDefault();
          if (typeof shipRocketMarketingLogin === 'function') {
            shipRocketMarketingLogin();
          } else {
            console.warn('shipRocketMarketingLogin function is not defined.');
            window.location.href = '/account/login';
          }
        };
      }

      accountLinkDesktop.innerHTML = accountIconSVG;

      // Append the custom icon right after the cart container
      accountContainerDesktop.appendChild(accountLinkDesktop);
    }
  }

  // Function to add the custom account icon at the right position for mobile
  function addAccountIconMobile() {
    var accountContainerMobile = document.querySelector('.header-mobile__item.header-mobile__item--cart');

    if (accountContainerMobile) {
      var accountLinkMobile = document.createElement('a');
      accountLinkMobile.classList.add('custom-account-icon');
      accountLinkMobile.title = 'Account';

      if (isCustomerLoggedIn()) {
        // User is logged in: Link to /account
        accountLinkMobile.href = '/account';
      } else {
        // User is not logged in: Trigger login function on click
        accountLinkMobile.href = '#';
        accountLinkMobile.onclick = function(event) {
          event.preventDefault();
          if (typeof shipRocketMarketingLogin === 'function') {
            shipRocketMarketingLogin();
          } else {
            console.warn('shipRocketMarketingLogin function is not defined.');
            window.location.href = '/account/login';
          }
        };
      }

      accountLinkMobile.innerHTML = accountIconSVG;

      // Append the custom icon to the mobile header
      accountContainerMobile.appendChild(accountLinkMobile);
    }
  }

  // Ensure the functions are called after DOM is loaded
  document.addEventListener('DOMContentLoaded', function() {
    removeNativeAccountIcon();
    addAccountIconDesktop();  // Add custom icon to desktop
    addAccountIconMobile();   // Add custom icon to mobile
  });
  </script> {% endcomment %}

