      - Background & text color settings that cannot be overridden by theme
      - No button
    {% endcomment %}
    
    <section id="shopify-section-{{ section.id }}" class="athflex-annbar"
      style="--annbar-bg: {{ section.settings.bg_color }}; --annbar-color: {{ section.settings.text_color }};">
