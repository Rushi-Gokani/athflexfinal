{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    width: 100%;
    position: relative;
    overflow: hidden;
    padding: {{ block.settings.padding_vertical }}px 16px;
  }

  .ai-announcement-bar__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    min-height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-announcement-bar__messages-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    text-align: center;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.4;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }}.is-active {
    opacity: 1;
    visibility: visible;
    position: relative;
    transform: none;
  }

  .ai-announcement-bar__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    font-size: {{ block.settings.icon_size }}px;
  }

  .ai-announcement-bar__text-{{ ai_gen_id }} {
    flex-grow: 0;
  }

  .ai-announcement-bar__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
  }

  .ai-announcement-bar__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.text_color }};
    opacity: 0.3;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-announcement-bar__dot-{{ ai_gen_id }}:hover {
    opacity: 0.6;
    transform: scale(1.2);
  }

  .ai-announcement-bar__dot-{{ ai_gen_id }}.is-active {
    opacity: 1;
    transform: scale(1.3);
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__message-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }

    .ai-announcement-bar__icon-{{ ai_gen_id }} {
      font-size: {{ block.settings.icon_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }} class="ai-announcement-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-announcement-bar__container-{{ ai_gen_id }}">
    <div class="ai-announcement-bar__messages-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% assign message_key = 'message_' | append: i %}
        {% assign icon_key = 'icon_' | append: i %}
        {% assign message = block.settings[message_key] %}
        {% assign icon = block.settings[icon_key] %}
        
        {% if message != blank %}
          <div class="ai-announcement-bar__message-{{ ai_gen_id }}{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
            {% if icon != blank %}
              <span class="ai-announcement-bar__icon-{{ ai_gen_id }}" aria-hidden="true">{{ icon }}</span>
            {% endif %}
            <span class="ai-announcement-bar__text-{{ ai_gen_id }}">{{ message }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% assign message_count = 0 %}
    {% for i in (1..5) %}
      {% assign message_key = 'message_' | append: i %}
      {% if block.settings[message_key] != blank %}
        {% assign message_count = message_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if block.settings.show_dots and message_count > 1 %}
      <div class="ai-announcement-bar__dots-{{ ai_gen_id }}" role="tablist" aria-label="Announcements">
        {% for i in (1..5) %}
          {% assign message_key = 'message_' | append: i %}
          {% if block.settings[message_key] != blank %}
            <button 
              class="ai-announcement-bar__dot-{{ ai_gen_id }}{% if forloop.first %} is-active{% endif %}" 
              data-index="{{ forloop.index0 }}" 
              aria-label="Go to announcement {{ forloop.index }}"
              role="tab"
            ></button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.messages = this.querySelectorAll('.ai-announcement-bar__message-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-announcement-bar__dot-{{ ai_gen_id }}');
        this.currentIndex = 0;
        this.autoplayInterval = null;
        this.intervalDuration = {{ block.settings.autoplay_speed | times: 1000 }};
      }

      connectedCallback() {
        if (this.messages.length <= 1) return;

        this.setupDots();
        this.startAutoplay();
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }

      setupDots() {
        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            this.stopAutoplay();
            this.startAutoplay();
          });
        });
      }

      goToSlide(index) {
        this.messages.forEach((message, i) => {
          if (i === index) {
            message.classList.add('is-active');
          } else {
            message.classList.remove('is-active');
          }
        });

        this.dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('is-active');
          } else {
            dot.classList.remove('is-active');
          }
        });

        this.currentIndex = index;
      }

      nextSlide() {
        const nextIndex = (this.currentIndex + 1) % this.messages.length;
        this.goToSlide(nextIndex);
      }

      startAutoplay() {
        if (!{{ block.settings.enable_autoplay | json }}) return;
        
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.intervalDuration);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

