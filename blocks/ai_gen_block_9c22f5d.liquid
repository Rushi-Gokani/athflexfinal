{% doc %}
  @prompt
    create the same annoucement bar like ella theme but add the autoplay, add text backgound color options, fill the bar with black color
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    overflow: hidden;
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .ai-announcement-bar-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ block.settings.bar_height }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .ai-announcement-bar-slider-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-announcement-bar-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
  }

  .ai-announcement-bar-slide-{{ ai_gen_id }} {
    min-width: 100%;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex-shrink: 0;
  }

  .ai-announcement-bar-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }};
    max-width: 100%;
    word-wrap: break-word;
    overflow-wrap: break-word;
    {% if block.settings.text_background_color != blank and block.settings.text_background_color != 'rgba(0,0,0,0)' %}
      background-color: {{ block.settings.text_background_color }};
      padding: {{ block.settings.text_bg_padding_vertical }}px {{ block.settings.text_bg_padding_horizontal }}px;
      border-radius: {{ block.settings.text_bg_border_radius }}px;
      display: inline-block;
    {% endif %}
  }

  .ai-announcement-bar-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: {{ block.settings.link_decoration }};
  }

  .ai-announcement-bar-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
    text-decoration: {{ block.settings.link_hover_decoration }};
  }

  .ai-announcement-bar-nav-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
  }

  .ai-announcement-bar-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.4;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-announcement-bar-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-announcement-bar-controls-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    padding: 0 {{ block.settings.padding_horizontal }}px;
  }

  .ai-announcement-bar-arrow-{{ ai_gen_id }} {
    background: none;
    border: none;
    color: {{ block.settings.arrow_color }};
    cursor: pointer;
    padding: 8px;
    pointer-events: all;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .ai-announcement-bar-arrow-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-announcement-bar-arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.enable_autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-bar-wrapper-{{ ai_gen_id }}">
    <div class="ai-announcement-bar-slider-{{ ai_gen_id }}">
      <div class="ai-announcement-bar-track-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign message_key = 'message_' | append: i
            assign link_key = 'link_' | append: i
            assign message = block.settings[message_key]
            assign link = block.settings[link_key]
          %}
          {% if message != blank %}
            <div class="ai-announcement-bar-slide-{{ ai_gen_id }}" data-slide="{{ forloop.index0 }}">
              <div class="ai-announcement-bar-content-{{ ai_gen_id }}">
                {% if link != blank %}
                  <a href="{{ link }}">{{ message }}</a>
                {% else %}
                  {{ message }}
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if block.settings.show_navigation %}
        <div class="ai-announcement-bar-nav-{{ ai_gen_id }}">
          {% for i in (1..5) %}
            {% liquid
              assign message_key = 'message_' | append: i
              assign message = block.settings[message_key]
            %}
            {% if message != blank %}
              <button
                class="ai-announcement-bar-dot-{{ ai_gen_id }}"
                data-index="{{ forloop.index0 }}"
                aria-label="Go to announcement {{ forloop.index }}"
              ></button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if block.settings.show_arrows %}
      <div class="ai-announcement-bar-controls-{{ ai_gen_id }}">
        <button
          class="ai-announcement-bar-arrow-{{ ai_gen_id }} ai-announcement-bar-prev-{{ ai_gen_id }}"
          aria-label="Previous announcement"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          class="ai-announcement-bar-arrow-{{ ai_gen_id }} ai-announcement-bar-next-{{ ai_gen_id }}"
          aria-label="Next announcement"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-announcement-bar-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-announcement-bar-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-announcement-bar-dot-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-announcement-bar-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-announcement-bar-next-{{ ai_gen_id }}');
        
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 5000;

        if (this.slides.length <= 1) {
          if (this.prevBtn) this.prevBtn.style.display = 'none';
          if (this.nextBtn) this.nextBtn.style.display = 'none';
          return;
        }

        this.setupEventListeners();
        this.updateSlide(0);

        if (this.autoplay) {
          this.startAutoplay();
          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay());
        }
      }

      setupEventListeners() {
        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', () => this.goToPrevSlide());
        }

        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', () => this.goToNextSlide());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            if (this.autoplay) {
              this.stopAutoplay();
              this.startAutoplay();
            }
          });
        });
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlide(index);
      }

      goToNextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.slides.length;
        this.updateSlide(this.currentSlide);
      }

      goToPrevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.updateSlide(this.currentSlide);
      }

      updateSlide(index) {
        this.track.style.transform = `translateX(-${index * 100}%)`;
        
        this.dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.goToNextSlide();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

