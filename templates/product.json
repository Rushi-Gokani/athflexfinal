erflow-x: auto;\n  scroll-snap-type: x mandatory;\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: none;\n  padding-bottom: 5px;\n}\n\n.offer-box-slider::-webkit-scrollbar {\n  display: none;\n}\n\n\/* --- Offer Box Style --- *\/\n.offer-box {\n  flex: 0 0 220px;\n  border: 1px solid #e0e0e0;\n  border-radius: 8px;\n  background: #f8f8f8;\n  padding: 8px 10px;\n  box-shadow: 0 1px 2px rgba(0,0,0,0.06);\n  scroll-snap-align: start;\n  transition: all 0.25s ease;\n  text-align: center;\n}\n\n.offer-box:hover {\n  background: #f1f1f1;\n  transform: translateY(-2px);\n}\n\n\/* --- Typography --- *\/\n.offer-box h4 {\n  font-size: 13px;\n  font-weight: 700;\n  color: #000;\n  margin: 4px 0;\n}\n\n.offer-box p {\n  font-size: 12px;\n  color: #444;\n  margin: 2px 0 8px 0;\n  line-height: 1.3;\n}\n\n.offer-code {\n  font-weight: 600;\n  font-size: 11.5px;\n  background: #000;\n  color: #fff;\n  padding: 3px 7px;\n  border-radius: 3px;\n  display: inline-block;\n  letter-spacing: 0.3px;\n}\n\n.offer-terms {\n  font-size: 11px;\n  color: #777;\n  text-decoration: underline;\n  cursor: pointer;\n  display: block;\n  margin-top: 4px;\n}\n\n\/* --- Slider Arrows (Desktop) --- *\/\n.offer-arrow {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  background: rgba(0,0,0,0.6);\n  color: #fff;\n  border: none;\n  width: 26px;\n  height: 26px;\n  border-radius: 50%;\n  cursor: pointer;\n  display: none;\n  justify-content: center;\n  align-items: center;\n  z-index: 2;\n}\n\n.offer-arrow:hover {\n  background: rgba(0,0,0,0.8);\n}\n\n.offer-arrow.left {\n  left: -10px;\n}\n\n.offer-arrow.right {\n  right: -10px;\n}\n\n\/* --- Show Arrows on Desktop --- *\/\n@media (min-width: 768px) {\n  .offer-arrow {\n    display: flex;\n  }\n}\n<\/style>\n\n<div class=\"offer-box-wrapper\">\n  <button class=\"offer-arrow left\" onclick=\"scrollOffers(-1)\">‹<\/button>\n\n  <div class=\"offer-box-slider\" id=\"offerSlider\">\n    <!-- Offer 1 -->\n    <div class=\"offer-box\">\n      <h4>🎉 Buy Any 3 Items<\/h4>\n      <p>Get <b>Flat 15% Off<\/b><\/p>\n      <span class=\"offer-code\">B3G15<\/span>\n      <span class=\"offer-terms\">📦 T&amp;C Apply<\/span>\n    <\/div>\n\n    <!-- Offer 2 -->\n    <div class=\"offer-box\">\n      <h4>🔥 Buy Any 2 Items<\/h4>\n      <p>Get <b>Flat 5% Off<\/b><\/p>\n      <span class=\"offer-code\">B2G5<\/span>\n      <span class=\"offer-terms\">📦 T&amp;C Apply<\/span>\n    <\/div>\n  <\/div>\n\n  <button class=\"offer-arrow right\" onclick=\"scrollOffers(1)\">›<\/button>\n<\/div>\n\n<script>\nfunction scrollOffers(direction) {\n  const slider = document.getElementById('offerSlider');\n  const scrollAmount = 240;\n  slider.scrollBy({\n    left: direction * scrollAmount,\n    behavior: 'smooth'\n  });\n}\n<\/script>"}},"faa2b3e6-c0a1-4269-baa6-d2605efe4c05":{"type":"quantity_selector","settings":{"qty_style":"1","qty_layout":"1","spacing_top":0,"spacing_bottom":10}},"04ea8843-f461-4f1d-8ea4-43f62fdfb21e":{"type":"perks","settings":{"spacing_top":0,"spacing_bottom":22,"show_size_chart":false,"size_chart_type":"product_type","size_chart_image_type":"jpg","show_compare_color":true,"show_compare_color_drop_drap":true,"compare_layout":"2"}},"f1b31d90-1e43-4948-9fe3-97ba43f6fb34":{"type":"buy_buttons","settings":{"show_dynamic_checkout":true,"show_gift_card_recipient":false,"spacing_top":0,"spacing_bottom":2,"atc_animation":"horizontal-shaking","atc_color":"#ffffff","atc_border_color":"#232323","atc_bg_color":"#232323","atc_bg_color_gradient":"","atc_color_hover":"#232323","atc_border_color_hover":"#232323","atc_bg_color_hover":"#ffffff","atc_bg_color_gradient_hover":"","bin_color":"#232323","bin_border_color":"#acacac","bin_bg_color":"#ffffff","bin_bg_color_gradient":"","bin_color_hover":"#232323","bin_border_color_hover":"#acacac","bin_bg_color_hover":"#ffffff","bin_bg_color_hover_gradient":""}},"custom_liquid_MKdYgf":{"type":"custom_liquid","name":"Loved by 2lakh+ customers","settings":{"custom_liquid":"<div class=\"af-benefit-wrapper\">\n  <div class=\"af-benefit-banner\" data-benefit-banner>\n    <div class=\"af-benefit-inner\">\n      <span class=\"af-benefit-icon\" data-benefit-icon>⚡<\/span>\n      <span class=\"af-benefit-text\" data-benefit-text><\/span>\n    <\/div>\n    <div class=\"af-benefit-dots\">\n      <span class=\"af-benefit-dot af-active\"><\/span>\n      <span class=\"af-benefit-dot\"><\/span>\n      <span class=\"af-benefit-dot\"><\/span>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n  .af-benefit-wrapper {\n    margin-top: 14px;\n  }\n\n  .af-benefit-banner {\n    width: 100%;\n    background: #000;\n    color: #fff;\n    border-radius: 0px;\n    padding: 10px 18px 12px;\n    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.25);\n    box-sizing: border-box;\n  }\n\n  .af-benefit-inner {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    font-size: 13px;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    font-weight: 600;\n    text-align: center;\n    white-space: nowrap;\n  }\n\n  .af-benefit-icon {\n    font-size: 18px;\n    flex-shrink: 0;\n  }\n\n  .af-benefit-text {\n    display: inline-block;\n    opacity: 0;\n    transform: translateY(8px);\n    transition: opacity 0.45s ease, transform 0.45s ease;\n  }\n\n  .af-benefit-text.af-show {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .af-benefit-dots {\n    display: flex;\n    justify-content: center;\n    gap: 6px;\n    margin-top: 6px;\n  }\n\n  .af-benefit-dot {\n    width: 6px;\n    height: 6px;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.35);\n    transition: transform 0.25s ease, background 0.25s ease;\n  }\n\n  .af-benefit-dot.af-active {\n    background: #ffffff;\n    transform: scale(1.25);\n  }\n\n  \/* Make sure it follows the width of the product form column *\/\n  .shopify-section .af-benefit-wrapper {\n    max-width: 100%;\n  }\n\n  @media (max-width: 749px) {\n    .af-benefit-inner {\n      font-size: 12px;\n      letter-spacing: 0.06em;\n      padding: 0 2px;\n      white-space: normal;\n    }\n  }\n<\/style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    const banners = document.querySelectorAll('[data-benefit-banner]');\n    if (!banners.length) return;\n\n    const slides = [\n      { text: 'SHIPS WITHIN 24 HOURS', icon: '⚡' },\n      { text: 'LOVED BY 2 LAKH+ CUSTOMERS', icon: '❤️' },\n      { text: '4.5 OUT OF 5 STAR RATINGS', icon: '⭐' }\n    ];\n\n    banners.forEach(function(banner) {\n      const textEl = banner.querySelector('[data-benefit-text]');\n      const iconEl = banner.querySelector('[data-benefit-icon]');\n      const dots = banner.querySelectorAll('.af-benefit-dot');\n\n      let index = 0;\n\n      function showSlide(i) {\n        if (!textEl || !iconEl) return;\n\n        textEl.classList.remove('af-show');\n\n        setTimeout(function() {\n          const slide = slides[i];\n          textEl.textContent = slide.text;\n          iconEl.textContent = slide.icon;\n          textEl.classList.add('af-show');\n\n          dots.forEach((dot, dotIndex) => {\n            dot.classList.toggle('af-active', dotIndex === i);\n          });\n        }, 250);\n      }\n\n      \/\/ First slide\n      showSlide(index);\n\n      \/\/ Auto-rotate\n      setInterval(function() {\n        index = (index + 1) % slides.length;\n        showSlide(index);\n      }, 2600);\n    });\n  });\n<\/script>"}},"custom_liquid_HAKdeD":{"type":"custom_liquid","settings":{"custom_liquid":""}},"custom_liquid_Ry4C7A":{"type":"custom_liquid","name":"Offers","disabled":true,"settings":{"custom_liquid":"<div class=\"offer-accordion\" data-offer-accordion>\n  <button class=\"offer-accordion__head\" type=\"button\">\n    <span>Offers &amp; Benefits<\/span>\n    <span class=\"offer-accordion__icon\" aria-hidden=\"true\">+<\/span>\n  <\/button>\n\n  <div class=\"offer-accordion__body\">\n    <p class=\"offer-accordion__title\">Payment Offers<\/p>\n    <ul class=\"offer-accordion__list\">\n      <li>Flat Rs.150 cashback using Jupiter UPI &amp; Rupay CC<\/li>\n      <li>Get 5% cashback upto Rs 50 by using POP UPI<\/li>\n    <\/ul>\n  <\/div>\n<\/div>"}},"bik_back_in_stock_notifier_dqQDJM":{"type":"shopify:\/\/apps\/bik\/blocks\/backInStockNotifier\/4ee0506d-3abc-448e-9d32-1ea2950714ec","settings":{"popupId":"bik-cta-luUl7zeeKXj5ohzf87mk","buttonText":"Notify on stock availability","fontSize":14,"buttonTextColour":"#ffffff","alignment":"fillContainer","width":300,"borderRadius":2,"borderWidth":0,"backgroundGradient":"linear-gradient(180deg, rgba(248, 248, 248, 1) 2%, rgba(13, 13, 13, 1) 6%)","borderColour":"#000000"}},"custom_liquid_CjWMFC":{"type":"custom_liquid","settings":{"custom_liquid":"{% render 'upsell-container' , product:product %}"}},"bd066b80-c8e3-4f3e-8280-b27fbf6e9423":{"type":"description","settings":{"open_tab_mobile":true,"title":"Spec & Description","enable_btn_show_more":false,"maximum_des_to_show":300}},"87197f5f-be0e-4b89-9270-62bf6917ebe7":{"type":"custom","settings":{"open_tab_mobile":false,"title":"Material & Care","type":"all","content":"WASH CARE INSTRUCTIONS - Give it a cold machine wash and hang it dry. We recommend washing and drying this inside-out.","enable_btn_show_more":false,"maximum_des_to_show":300,"product_custom_source":"dynamic","product_tab_key_metafield":""}},"3d9ea84d-5527-4bce-abe6-5debef3ec955":{"type":"custom","settings":{"open_tab_mobile":false,"title":"Shipping & Return","type":"all","content":"<p>Returns Policy<\/p>\n<p>Timeline:<br>- Hassle free Returns & exchanges are accepted within 7 days from the delivery date.<br>- Post 7 days, returns & exchanges are not applicable.<br><br>- Returns are only accepted for wrong size, color, or damaged products.<br><br>Shipping Costs:<br>- Shipping costs are calculated during checkout based on the chosen shipping method.<br>- Free Standard Shipping (2-4 Business Days) is available for Prepaid Orders.<br>- Regular Shipping (4-6 Business Days) for Cash On Delivery Orders is charged at 120 INR.<\/p>\n<p>Returns:<br>- Returns due to product issues are accepted within 7 days of receipt, provided the item is in its original, unused, and resalable condition.<br>- Refunds for returned items will be processed as store credit\/original payment for pre-paid orders for future purchases, excluding shipping fees & discounts.<br>Shipping<br>- COD orders are by default processed as store credit <br>For any inquiries or assistance, reach us at +91-70693 19266 Via Call\/WhatsApp.<\/p>\n<p>Exchange and Return Fees: A second exchange will be charged at ₹100 & Return Refunds are only offered for wrong size, color, or defective products. Store credit of the same amount will be provided.<\/p>\n<p>Same Pricing or Above: Exchange is possible only for products of the same price or higher. We don't do exchanges for products priced below the original item.<\/p>\n<p>.<br>Dispatch Time:<br>- Orders are usually dispatched within 24 hours (Mon-Fri). Orders made on Saturdays or national holidays are dispatched within 48 hours.<br>- Address changes can be accommodated before dispatch.<\/p>","enable_btn_show_more":false,"maximum_des_to_show":300,"product_custom_source":"dynamic","product_tab_key_metafield":""}},"683f2b15-db3b-4f63-8d0f-e688cc678581":{"type":"customer_viewing","disabled":true,"settings":{"customer_viewing_number":"283, 100, 59, 11, 14, 185, 193, 165, 50, 38, 99, 112, 46, 10, 125, 200, 250, 18","customer_viewing_time":5,"spacing_top":0,"spacing_bottom":22}},"19de9abb-17c8-4d67-941d-b32706ed06fd":{"type":"pickup_availability","disabled":true,"settings":{"show_pickup_availability":true,"spacing_top":0,"spacing_bottom":27}},"10093fcf-2053-47e9-bedb-841bb0d046fa":{"type":"trust_image","disabled":true,"settings":{"show_trust_image":true,"spacing_top":0,"spacing_bottom":0}},"b9d6eb19-10f4-41f8-bfdc-ea10e8b3182a":{"type":"custom","disabled":true,"settings":{"open_tab_mobile":false,"title":"Custom Tab","type":"a